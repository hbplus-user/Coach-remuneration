# Browser (safe to expose — RLS enforces access)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only this Google Workspace domain may sign in
VITE_ALLOWED_EMAIL_DOMAIN=hbplus.fit

VITE_SUPABASE_ANON_KEY=your-anon-key

# Seed script only — never commit or expose this one
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The HB+ admin API, for coach reviews, the session summary and availability.
#
# Leave these unset and the browser calls admin.hbplus.fit directly, which only
# works once that API allows this site's origin (see ADMIN-API-CORS.md) and
# needs a token typed into the fetch panel each session.
#
# Set them to the bundled proxy instead and neither applies: the call goes to
# this app's own domain, so there is no cross-origin request, and the token
# lives on the server in HB_ADMIN_TOKEN below.
# VITE_REVIEW_API_BASE=/api/hb/feedbacks
# VITE_SESSION_API_BASE=/api/hb/sessions
# VITE_AVAILABILITY_API_BASE=/api/hb/availability

# Server side only, read by api/hb/[...path].js. NOT a VITE_ variable, and it
# must never become one: every VITE_ value is compiled into the JavaScript and
# readable by anyone who opens the app. Set it in the Vercel dashboard under
# Settings -> Environment Variables.
# HB_ADMIN_TOKEN=the-admin-api-token
# HB_ADMIN_API_BASE=https://admin.hbplus.fit

# Local testing of the proxy with `npm run dev` (vite.config.js reads these on
# the server; neither is a VITE_ variable, so neither reaches the browser).
# Set the token if you have one, or paste your own admin.hbplus.fit session
# cookie from DevTools to try it before a token exists.
# HB_ADMIN_COOKIE=connect.sid=...
